# Copy to `.env` and fill in. Nothing loads this file automatically yet — export
# it into your shell (`set -a; source .env; set +a`) or use your own tooling.
# Phase 3 owns picking a loader if one is wanted.

# --- LLM (Phase 3) ---
MEM0_LLM_ADAPTER=
MEM0_LLM_MODEL=
MEM0_LLM_API_KEY=

# --- Embedder (Phase 3) ---
MEM0_EMBEDDER_ADAPTER=
MEM0_EMBEDDER_MODEL=
MEM0_EMBEDDER_API_KEY=

# Set to `true` to log full LLM prompts and completions, including memory
# contents. Off by default; see the redaction policy in config/config.exs.
MEM0_LOG_LLM_PAYLOADS=
