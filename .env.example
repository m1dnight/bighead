# Copy to `.env` and fill in. Nothing loads this file automatically — export it
# into your shell (`set -a; source .env; set +a`) or use your own tooling.
#
# Every variable the application reads appears here, because this file is the
# only documentation of the contract that cannot drift silently:
# `config/runtime.exs` is the one place that calls `System.get_env/1`, and
# `EnvGuard.required/3` raises at boot when a required variable is missing.
#
# Both providers default to `stub`. A clean checkout with no `.env`, no API key
# and no Ollama boots, and `mix test` passes.

# --- LLM (extraction and the update decision) -------------------------------
MEM0_LLM_PROVIDER=stub               # anthropic | stub
ANTHROPIC_API_KEY=sk-ant-...         # required only when the provider is `anthropic`
MEM0_LLM_MODEL=claude-opus-5
# Caps thinking *plus* response text together — thinking is on by default on
# Claude Opus 5. A default with room, not a tuned number.
MEM0_LLM_MAX_TOKENS=16000

# --- Embedder (retrieval) ---------------------------------------------------
MEM0_EMBEDDER_PROVIDER=stub          # ollama | stub
OLLAMA_BASE_URL=http://localhost:11434
MEM0_EMBEDDING_MODEL=nomic-embed-text
# The width the `vector(N)` column will have to declare. Must match the model:
# nomic-embed-text is 768, mxbai-embed-large 1024, all-minilm 384.
MEM0_EMBEDDING_DIMENSIONS=768

# --- Claude Code hook ingress -----------------------------------------------
# The server-side identity every ingested message is attributed to. Never read
# from the request body: a payload claiming another user is still filed here.
# One user until bearer tokens land.
MEM0_DEFAULT_USER_ID=local

# --- Logging ----------------------------------------------------------------
# Set to `true` to log full LLM prompts and completions, including memory
# contents. Off by default; see the redaction policy in config/config.exs.
MEM0_LOG_LLM_PAYLOADS=false
